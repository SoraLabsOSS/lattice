{
  "name": "@soralabsoss/generator",
  "version": "0.1.0",
  "description": "Pure TypeScript design-token generator: OKLCH ramps, WCAG-AA-validated semantic tokens, and CSS / DTCG / Tailwind / shadcn exporters from a few brand inputs.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/SoraLabsOSS/sora-lattice/tree/main/packages/generator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoraLabsOSS/sora-lattice.git",
    "directory": "packages/generator"
  },
  "bugs": "https://github.com/SoraLabsOSS/sora-lattice/issues",
  "keywords": [
    "design-tokens",
    "shadcn",
    "tailwind",
    "oklch",
    "theme",
    "wcag"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.20.8"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "culori": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  }
}
