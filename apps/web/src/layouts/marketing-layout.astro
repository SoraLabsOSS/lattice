---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Header from "../components/header.astro";
import Loader from "../components/loader.astro";

export interface Props {
  description?: string;
  title?: string;
}

const {
  title = "Sora Lattice - Build a design system in 10 minutes",
  description = "Tokens, components, Figma, and complete documentation—customized to your brand. Skip the 6-month setup and start building today.",
} = Astro.props;

const ogImage = new URL("/og.jpg", Astro.site ?? Astro.url);
---

<!doctype html>
<html class="lenis" lang="en">
  <head>
    <meta charset="UTF-8">
    <meta content={description} name="description">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="/favicon.svg" rel="icon" type="image/svg+xml">
    <meta content={Astro.generator} name="generator">
    <title>{title}</title>

    <meta content="website" property="og:type">
    <meta content={title} property="og:title">
    <meta content={description} property="og:description">
    <meta content={ogImage.href} property="og:image">
    <meta content="Sora Lattice" property="og:image:alt">
    <meta content="summary_large_image" property="twitter:card">
    <meta content={title} property="twitter:title">
    <meta content={description} property="twitter:description">
    <meta content={ogImage.href} property="twitter:image">
    <meta content="Sora Lattice" property="twitter:image:alt">

    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect">

    <ClientRouter />
  </head>
  <body>
    <Loader />
    <div transition:persist="marketing-header">
      <Header />
    </div>
    <div id="marketing-content" transition:animate="fade">
      <slot />
    </div>

    <script>
      import "../scripts/page-exit";
    </script>

    <!-- Locomotive Scroll v5 -->
    <script>
      import LocomotiveScroll from "locomotive-scroll";

      function initLenis() {
        const p = window.location.pathname;
        if (p === "/generate" || p === "/generate/") {
          return;
        }

        // Destroy previous instance if it exists
        if ((window as any).locomotiveScroll) {
          try {
            (window as any).locomotiveScroll.destroy();
          } catch {
            // destroy() throws if already destroyed; safe to ignore
          }
        }

        const scroll = new LocomotiveScroll({
          lenisOptions: {
            duration: 1.2,
            easing: (t: number) => Math.min(1, 1.001 - 2 ** (-10 * t)),
            gestureOrientation: "vertical",
            orientation: "vertical",
            smoothWheel: true,
            touchMultiplier: 2,
            wheelMultiplier: 1,
          },
        });

        (window as any).locomotiveScroll = scroll;
        (window as any).lenis = scroll.lenisInstance;

        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener("click", (e) => {
            e.preventDefault();
            const targetId = (anchor as HTMLAnchorElement).getAttribute("href");
            if (targetId && targetId !== "#") {
              const target = document.querySelector(targetId);
              if (target) {
                scroll.scrollTo(target as HTMLElement, {
                  duration: 1.5,
                  offset: 0,
                });
              }
            }
          });
        });
      }

      initLenis();
      document.addEventListener("astro:after-swap", initLenis);
    </script>
  </body>
</html>
