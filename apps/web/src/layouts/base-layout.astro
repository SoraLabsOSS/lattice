---
import SeoHead from "../components/seo-head.astro";
import "../styles/global.css";

export interface Props {
  description?: string;
  title?: string;
}

const {
  title = "Sora Lattice - Build a design system in 10 minutes",
  description = "Tokens, components, Figma, and complete documentation—customized to your brand. Skip the 6-month setup and start building today.",
} = Astro.props;
---

<!doctype html>
<html class="lenis" lang="en">
  <head>
    <SeoHead description={description} title={title} />
  </head>
  <body>
    <slot />

    <!-- Locomotive Scroll v5 -->
    <script>
      import LocomotiveScroll from "locomotive-scroll";

      // Initialize Locomotive Scroll (built on Lenis)
      const scroll = new LocomotiveScroll({
        lenisOptions: {
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - 2 ** (-10 * t)),
          gestureOrientation: "vertical",
          orientation: "vertical",
          smoothWheel: true,
          touchMultiplier: 2,
          wheelMultiplier: 1,
        },
      });

      // Expose scroll instance to window for debugging
      if (typeof window !== "undefined") {
        (window as any).locomotiveScroll = scroll;
        (window as any).lenis = scroll.lenisInstance;
      }

      // Handle anchor link smooth scrolling
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener("click", function (e) {
          e.preventDefault();
          const targetId = (this as HTMLAnchorElement).getAttribute("href");
          if (targetId && targetId !== "#") {
            const target = document.querySelector(targetId);
            if (target) {
              scroll.scrollTo(target as HTMLElement, {
                duration: 1.5,
                offset: 0,
              });
            }
          }
        });
      });
    </script>
  </body>
</html>
