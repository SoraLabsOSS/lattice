---
import "../styles/global.css";
import Loader from "../components/loader.astro";
import SeoHead from "../components/seo-head.astro";

export interface Props {
  description?: string;
  title?: string;
}

const {
  title = "Generate | Sora Lattice",
  description = "Configure and generate your design system tokens.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SeoHead description={description} title={title} />
  </head>
  <body>
    <Loader />
    <div class="flex flex-col h-dvh">
      <div class="flex-1 min-h-0" id="generator-content">
        <slot />
      </div>
    </div>

    <script>
      import "../scripts/page-exit";
    </script>

    <!-- No Locomotive Scroll on generator — scroll is handled per-panel -->
    <script>
      if ((window as any).locomotiveScroll) {
        try {
          (window as any).locomotiveScroll.destroy();
        } catch {
          // destroy() throws if already destroyed; safe to ignore
        }
        (window as any).locomotiveScroll = null;
        (window as any).lenis = null;
      }
    </script>
  </body>
</html>
