<!--
  Reusable loader component used on initial page load and Mode A route transitions.

  Modes (via `data-loader-mode`):
    "initial"    → first page load: plays CSS keyframe, then switches to "transition" mode
    "transition" → controlled programmatically by view-transitions.ts

  Uses `transition:persist` so the same DOM element survives across view-transition swaps.
-->

<div
  aria-hidden="true"
  class="fixed inset-0 z-100 flex items-center justify-center bg-white"
  data-loader-mode="initial"
  id="sora-lattice-loader"
>
  <svg
    aria-hidden="true"
    class="loader-logo"
    fill="none"
    height="40"
    viewBox="0 0 400 400"
    width="40"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="m287.5 199q18 0 34 7 16 7 27.5 19 12 11.5 19 27.5 7 16 7 34v87.5h-87.5q-18 0-34-6.5-16-7-28-19-11.5-12-18.5-28-7-16-7-34 0 18-7 34-7 16-19 28-11.5 12-27.5 19-16 6.5-34 6.5h-87.5v-87.5q0-18 7-34 7-16 18.5-27.5 12-12 28-19 16-7 34-7-18 0-34-6.5-16-7-28-19-11.5-12-18.5-28-7-16-7-34v-87.5h87.5q18 0 34 7 16 7 27.5 19 12 11.5 19 27.5 7 16 7 34 0-18 7-34 7-16 18.5-27.5 12-12 28-19 16-7 34-7h87.5v87.5q0 18-7 34-7 16-19 28-11.5 12-27.5 19-16 6.5-34 6.5z"
      fill="#5BA26B"
    />
  </svg>
</div>

<style>
  @reference "../styles/global.css";

  /* ---- Initial page-load animation (unchanged from original) ---- */

  #sora-lattice-loader[data-loader-mode="initial"] {
    animation: loaderOverlay 2.1s ease forwards 0s;
  }

  #sora-lattice-loader[data-loader-mode="initial"] .loader-logo {
    opacity: 0;
    animation: loaderLogoIn 1.8s ease forwards 0s;
  }

  @keyframes loaderLogoIn {
    0% {
      opacity: 0;
      transform: translateY(16px);
    }
    18% {
      opacity: 1;
      transform: translateY(0);
    }
    88% {
      opacity: 1;
      transform: translateY(0);
    }
    100% {
      opacity: 0;
      transform: translateY(-16px);
    }
  }

  @keyframes loaderOverlay {
    0%,
    90% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* ---- Transition mode: hidden by default, shown via .loader-visible ---- */

  #sora-lattice-loader[data-loader-mode="transition"] {
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    will-change: opacity;
  }

  #sora-lattice-loader[data-loader-mode="transition"] .loader-logo {
    opacity: 0;
  }

  #sora-lattice-loader[data-loader-mode="transition"].loader-visible {
    pointer-events: auto;
    opacity: 1;
  }

  #sora-lattice-loader[data-loader-mode="transition"].loader-visible
    .loader-logo {
    animation: loaderLogoTransition 1.1s ease forwards 0.12s;
  }

  @keyframes loaderLogoTransition {
    0% {
      opacity: 0;
      transform: translateY(12px);
    }
    18% {
      opacity: 1;
      transform: translateY(0);
    }
    82% {
      opacity: 1;
      transform: translateY(0);
    }
    100% {
      opacity: 0;
      transform: translateY(-12px);
    }
  }

  /* ---- Reduced motion ---- */

  @media (prefers-reduced-motion: reduce) {
    #sora-lattice-loader,
    #sora-lattice-loader .loader-logo {
      transition: none !important;
      animation: none !important;
    }

    #sora-lattice-loader[data-loader-mode="initial"] {
      opacity: 0;
    }
  }
</style>

<script>
  function initLoader(isSwap = false) {
    const loader = document.getElementById("sora-lattice-loader");
    if (!loader) {
      return;
    }

    if (isSwap) {
      // View transition swap — skip loader animation, hide immediately
      loader.dataset.loaderMode = "transition";
      loader.style.opacity = "0";
      loader.style.pointerEvents = "none";
      const logo = loader.querySelector(".loader-logo") as HTMLElement | null;
      if (logo) {
        logo.getAnimations().forEach((a) => a.cancel());
        logo.style.opacity = "0";
      }
      return;
    }

    if (loader.dataset.loaderMode === "initial") {
      const handler = (e: AnimationEvent) => {
        if (e.target !== loader) {
          return;
        }
        loader.removeEventListener("animationend", handler);
        loader.dataset.loaderMode = "transition";
        loader.style.opacity = "0";
        loader.style.pointerEvents = "none";
        const logo = loader.querySelector(".loader-logo") as HTMLElement | null;
        if (logo) {
          logo.getAnimations().forEach((a) => a.cancel());
          logo.style.opacity = "0";
        }
      };
      loader.addEventListener("animationend", handler);
    }
  }

  initLoader();
  document.addEventListener("astro:after-swap", () => initLoader(true));
</script>
