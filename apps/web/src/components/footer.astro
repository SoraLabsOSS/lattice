---
// Footer component
import { siteImages } from "../lib/site-images";

const currentYear = new Date().getFullYear();
---

<footer class="bg-gray py-20">
  <div class="container-custom">
    <div class="flex flex-col md:flex-row justify-between gap-12 md:gap-16">
      <!-- Logo Section -->
      <div class="flex flex-col justify-between">
        <a class="flex items-center gap-3 group mb-6" href="/">
          <img
            alt="Sora Lattice Logo"
            class="w-[30px]"
            src={siteImages.logoIcon}
          >
        </a>
        <p class="text-charcoal/80 text-sm">
          Copyright © {currentYear} Sora Lattice. All rights reserved.
        </p>
      </div>

      <!-- Links Grid -->
      <div class="md:col-span-8 grid grid-cols-2 gap-8 md:gap-12">
        <!-- Product -->
        <div>
          <h5 class="mb-4">Product</h5>
          <ul class="space-y-3">
            <li>
              <a
                class="text-charcoal font-light hover:text-forest-green-200 transition-colors"
                href="#how-it-works"
              >
                How it works
              </a>
            </li>
            <li>
              <a
                class="text-charcoal font-light hover:text-forest-green-200 transition-colors"
                href="#faq"
              >
                FAQ
              </a>
            </li>
          </ul>
        </div>

        <!-- Company -->
        <div>
          <h5 class="mb-4">Company</h5>
          <ul class="space-y-3">
            <li>
              <a
                class="text-charcoal font-light hover:text-forest-green-200 transition-colors"
                href="https://soralabs.studio"
                rel="noopener noreferrer"
                target="_blank"
              >
                About the developer
              </a>
            </li>
            <li>
              <a
                class="text-charcoal font-light hover:text-forest-green-200 transition-colors"
                href="mailto:truonggiang.axyl@gmail.com"
              >
                Contact
              </a>
            </li>
            <li>
              <a
                class="text-charcoal font-light hover:text-forest-green-200 transition-colors"
                href="https://x.com/axyl1410"
                rel="noopener noreferrer"
                target="_blank"
              >
                X / Twitter
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>
