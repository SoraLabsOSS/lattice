---
export interface Props {
  description: string;
  title: string;
}

const { title, description } = Astro.props;
const site = Astro.site ?? new URL("https://lattice.soralabs.studio/");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL("/og.jpg", site);
---

<meta charset="UTF-8">
<meta content={description} name="description">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<link href={canonical.href} rel="canonical">
<link href="/favicon-192.png" rel="icon" sizes="192x192" type="image/png">
<link href="/favicon-32.png" rel="icon" sizes="32x32" type="image/png">
<link href="/favicon.ico" rel="icon" sizes="any">
<link href="/favicon.svg" rel="icon" type="image/svg+xml">
<link href="/apple-touch-icon.png" rel="apple-touch-icon">
<meta content={Astro.generator} name="generator">
<title>{title}</title>

<meta content="website" property="og:type">
<meta content={title} property="og:title">
<meta content={description} property="og:description">
<meta content={canonical.href} property="og:url">
<meta content="Sora Lattice" property="og:site_name">
<meta content={ogImage.href} property="og:image">
<meta content="Sora Lattice" property="og:image:alt">

<meta content="summary_large_image" property="twitter:card">
<meta content={title} property="twitter:title">
<meta content={description} property="twitter:description">
<meta content={ogImage.href} property="twitter:image">
<meta content="Sora Lattice" property="twitter:image:alt">

<link href="https://fonts.googleapis.com" rel="preconnect">
<link crossorigin href="https://fonts.gstatic.com" rel="preconnect">
